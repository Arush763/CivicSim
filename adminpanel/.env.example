# Copy to adminpanel/.env
# The ngrok URL printed by scripts/start.sh (or http://<your-computer-LAN-IP>:3000 on the same Wi-Fi).
EXPO_PUBLIC_SERVER_URL=
# Supabase project URL + anon (public) key. Leave empty to run in local-only mode.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
# Google Maps Platform key (Maps JavaScript API, which includes Street View, + Places API (New)).
# Restrict it to the addresses the app and server run on, e.g. http://localhost:8082/* and http://localhost:3000/*.
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=
# Optional: a vector Map ID from Google Cloud > Map Management (3D buildings, tilt). Defaults to DEMO_MAP_ID.
EXPO_PUBLIC_GOOGLE_MAP_ID=
