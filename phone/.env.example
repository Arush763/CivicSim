# Copy to phone/.env (git ignores it).
# The laptop server: the ngrok URL printed by scripts/start.sh, or http://<laptop-LAN-IP>:3000 on the same Wi-Fi.
EXPO_PUBLIC_SERVER_URL=
# Supabase project URL + anon (public) key. Leave empty to try the app in local-only mode (no sign-in, petitions or ranks).
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
# Google Maps Platform key: Places API (New) for search (and Google Maps in store builds for Android).
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=
