# Copy to server/.env. Everything is optional: with nothing set the server runs in local-only mode.
PORT=3000
# Supabase (Project Settings → API). The service-role key stays on this PC — never put it in the app.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Enables "Get AI suggestions".
ANTHROPIC_API_KEY=
# Optional: raises NYC Open Data rate limits.
NYC_APP_TOKEN=
# Photo-real Street View renders (Gemini image editing). Get a key at aistudio.google.com/apikey.
# Note: editing Street View images goes against the Google Maps Platform terms (3.2.3(c)).
GEMINI_API_KEY=
# Optional: defaults to gemini-nano-banana-2.1
GEMINI_IMAGE_MODEL=
# The browser Maps key for the Street View page (restrict it to your websites).
GOOGLE_MAPS_BROWSER_KEY=
# Fetches Street View images server-side; enable the Street View Static API for it, and don't
# give it a website restriction (use an IP restriction instead).
GOOGLE_MAPS_SERVER_KEY=
# Most new photo-real (Gemini) renders per day (cached views don't count).
AI_DAILY_LIMIT=100
# Development only: test the photo-real viewer without Gemini (pastes the 3D guide into the photo).
AI_FAKE=
# Gemini through Vertex AI (billed to your Google Cloud project): an API key bound to a service account
# with the Vertex AI User role, and the project id. Or put a service-account JSON key at server/vertex-key.json.
VERTEX_API_KEY=
VERTEX_PROJECT=
# Photo-real views prepared as soon as a request comes in: how many Street View spots around it (0 = off).
PRERENDER_SPOTS=5
# Chrome/Chromium for preparing them in a hidden browser (found automatically on Mac and most Linux).
CHROME_PATH=
# When the main model is busy, try these (cheapest first), then the main one again, 0.1 s apart.
VERTEX_FALLBACK_MODELS=gemini-3.1-flash-lite-image,gemini-2.5-flash-image
# Give up on a busy edit after this long (ms).
VERTEX_BUSY_LIMIT_MS=60000
